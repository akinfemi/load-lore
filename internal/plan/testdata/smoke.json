{
  "run_id": "test-run",
  "name": "smoke",
  "scale": 1,
  "seed": 1,
  "duration": 60000000000,
  "services": [
    {
      "name": "api",
      "kind": "app",
      "image": "",
      "containers": [
        "api-0",
        "api-1"
      ],
      "cpu": 0.5,
      "memory": 268435456,
      "port": 8080,
      "synthetic": [
        {
          "service": "api",
          "replica": 0,
          "listen": ":8080",
          "concurrency": {
            "model": "threads",
            "max": 200
          },
          "cpu_ms": 1,
          "cpu_jitter": 0.1,
          "alloc_kb": 0,
          "calls": [
            {
              "target": "cache",
              "op": "get",
              "count": 1,
              "when": "read",
              "mode": "sync",
              "on_miss": [
                {
                  "target": "db",
                  "op": "read",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "query": "point"
                },
                {
                  "target": "cache",
                  "op": "set",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "ttl_s": 60
                }
              ]
            },
            {
              "target": "db",
              "op": "write",
              "count": 1,
              "when": "write",
              "mode": "sync"
            }
          ],
          "resilience": {
            "timeout_ms": 1000
          },
          "targets": {
            "cache": {
              "kind": "redis",
              "addrs": [
                "lore-toxiproxy:20000"
              ],
              "pool": 10,
              "row_bytes": 256
            },
            "db": {
              "kind": "postgres",
              "addrs": [
                "lore-toxiproxy:20001"
              ],
              "pool": 10,
              "database": "lab",
              "user": "loadlore",
              "password": "loadlore",
              "rows": 20000,
              "row_bytes": 256
            }
          }
        },
        {
          "service": "api",
          "replica": 1,
          "listen": ":8080",
          "concurrency": {
            "model": "threads",
            "max": 200
          },
          "cpu_ms": 1,
          "cpu_jitter": 0.1,
          "alloc_kb": 0,
          "calls": [
            {
              "target": "cache",
              "op": "get",
              "count": 1,
              "when": "read",
              "mode": "sync",
              "on_miss": [
                {
                  "target": "db",
                  "op": "read",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "query": "point"
                },
                {
                  "target": "cache",
                  "op": "set",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "ttl_s": 60
                }
              ]
            },
            {
              "target": "db",
              "op": "write",
              "count": 1,
              "when": "write",
              "mode": "sync"
            }
          ],
          "resilience": {
            "timeout_ms": 1000
          },
          "targets": {
            "cache": {
              "kind": "redis",
              "addrs": [
                "lore-toxiproxy:20000"
              ],
              "pool": 10,
              "row_bytes": 256
            },
            "db": {
              "kind": "postgres",
              "addrs": [
                "lore-toxiproxy:20001"
              ],
              "pool": 10,
              "database": "lab",
              "user": "loadlore",
              "password": "loadlore",
              "rows": 20000,
              "row_bytes": 256
            }
          }
        }
      ]
    },
    {
      "name": "cache",
      "kind": "redis",
      "image": "redis:8.2",
      "containers": [
        "cache"
      ],
      "cpu": 0.5,
      "memory": 134217728,
      "port": 6379,
      "version": "8"
    },
    {
      "name": "db",
      "kind": "postgres",
      "image": "postgres:17.11",
      "containers": [
        "db"
      ],
      "cpu": 1,
      "memory": 536870912,
      "port": 5432,
      "version": "17",
      "dataset": {
        "Rows": 20000,
        "RowBytes": 256,
        "Indexes": null
      }
    }
  ],
  "proxies": [
    {
      "name": "api--cache",
      "from": "api",
      "to": "cache",
      "upstream": "cache:6379",
      "listen": 20000
    },
    {
      "name": "api--db",
      "from": "api",
      "to": "db",
      "upstream": "db:5432",
      "listen": 20001
    }
  ],
  "workload": {
    "entry": "api",
    "urls": [
      "http://api-0:8080",
      "http://api-1:8080"
    ],
    "start_rate": 50,
    "stages": [
      {
        "target": 300,
        "duration": "30s"
      },
      {
        "target": 300,
        "duration": "30s"
      }
    ],
    "peak_rate": 300,
    "read_share": 0.9,
    "keys": {
      "distribution": "zipf",
      "count": 20000,
      "skew": 1.1
    },
    "payload_bytes": 1024,
    "max_vus": 600,
    "pre_vus": 75,
    "timeout": "10s"
  },
  "faults": [
    {
      "index": 0,
      "at": "20s",
      "for": "10s",
      "inject": "latency",
      "target": "db",
      "proxies": [
        "api--db"
      ],
      "add_ms": 50
    },
    {
      "index": 1,
      "at": "45s",
      "inject": "kill",
      "target": "api",
      "containers": [
        "api-1"
      ]
    }
  ],
  "infra": {
    "load_cpu": 1,
    "load_memory": 1073741824,
    "proxy_cpu": 0.5,
    "proxy_memory": 268435456,
    "prometheus_cpu": 1,
    "prometheus_memory": 1073741824,
    "cadvisor_cpu": 0.5,
    "cadvisor_memory": 268435456,
    "exporter_cpu": 0.25,
    "exporter_memory": 134217728,
    "expected_proxied_ops": 840.0000000000001,
    "synthetic_image": "loadlore/synthetic:dev"
  },
  "notes": [
    "Loadlore's own containers get fixed budgets: load generator 1 CPU (peak 300 rps), Toxiproxy 0.5 CPU (about 840 proxied calls/s at peak), Prometheus 1, cAdvisor 0.5, exporters 0.25 each"
  ]
}
