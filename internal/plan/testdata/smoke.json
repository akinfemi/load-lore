{
  "run_id": "test-run",
  "name": "smoke",
  "scale": 1,
  "seed": 1,
  "duration": 60000000000,
  "reuse_data": false,
  "services": [
    {
      "name": "api",
      "kind": "app",
      "image": "",
      "containers": [
        "api-0",
        "api-1"
      ],
      "cpu": 0.5,
      "cpu_period_ms": 100,
      "memory": 268435456,
      "port": 8080,
      "synthetic": [
        {
          "service": "api",
          "replica": 0,
          "listen": ":8080",
          "concurrency": {
            "model": "threads",
            "max": 200
          },
          "cpu_ms": 1,
          "cpu_jitter": 0.1,
          "alloc_kb": 0,
          "calls": [
            {
              "target": "cache",
              "op": "get",
              "count": 1,
              "when": "read",
              "mode": "sync",
              "on_miss": [
                {
                  "target": "db",
                  "op": "read",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "query": "point"
                },
                {
                  "target": "cache",
                  "op": "set",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "ttl_s": 60
                }
              ]
            },
            {
              "target": "db",
              "op": "write",
              "count": 1,
              "when": "write",
              "mode": "sync"
            }
          ],
          "resilience": {
            "timeout_ms": 1000
          },
          "targets": {
            "cache": {
              "kind": "redis",
              "addrs": [
                "lore-toxiproxy:20000"
              ],
              "pool": 10,
              "row_bytes": 256
            },
            "db": {
              "kind": "postgres",
              "addrs": [
                "lore-toxiproxy:20001"
              ],
              "pool": 10,
              "database": "lab",
              "user": "loadlore",
              "password": "loadlore",
              "rows": 20000,
              "row_bytes": 256
            }
          }
        },
        {
          "service": "api",
          "replica": 1,
          "listen": ":8080",
          "concurrency": {
            "model": "threads",
            "max": 200
          },
          "cpu_ms": 1,
          "cpu_jitter": 0.1,
          "alloc_kb": 0,
          "calls": [
            {
              "target": "cache",
              "op": "get",
              "count": 1,
              "when": "read",
              "mode": "sync",
              "on_miss": [
                {
                  "target": "db",
                  "op": "read",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "query": "point"
                },
                {
                  "target": "cache",
                  "op": "set",
                  "count": 1,
                  "when": "always",
                  "mode": "sync",
                  "ttl_s": 60
                }
              ]
            },
            {
              "target": "db",
              "op": "write",
              "count": 1,
              "when": "write",
              "mode": "sync"
            }
          ],
          "resilience": {
            "timeout_ms": 1000
          },
          "targets": {
            "cache": {
              "kind": "redis",
              "addrs": [
                "lore-toxiproxy:20000"
              ],
              "pool": 10,
              "row_bytes": 256
            },
            "db": {
              "kind": "postgres",
              "addrs": [
                "lore-toxiproxy:20001"
              ],
              "pool": 10,
              "database": "lab",
              "user": "loadlore",
              "password": "loadlore",
              "rows": 20000,
              "row_bytes": 256
            }
          }
        }
      ]
    },
    {
      "name": "cache",
      "kind": "redis",
      "image": "redis:8.2",
      "containers": [
        "cache"
      ],
      "cpu": 0.5,
      "cpu_period_ms": 100,
      "memory": 134217728,
      "port": 6379,
      "version": "8",
      "config": {
        "maxmemory": "98304kb",
        "maxmemory-policy": "allkeys-lru"
      }
    },
    {
      "name": "db",
      "kind": "postgres",
      "image": "postgres:17.11",
      "containers": [
        "db"
      ],
      "cpu": 1,
      "cpu_period_ms": 100,
      "memory": 536870912,
      "port": 5432,
      "version": "17",
      "dataset": {
        "Rows": 20000,
        "RowBytes": 256,
        "Indexes": null
      }
    },
    {
      "name": "lb",
      "kind": "lb",
      "image": "haproxy:3.2.26",
      "containers": [
        "lb"
      ],
      "cpu": 0.5,
      "cpu_period_ms": 100,
      "memory": 268435456,
      "port": 8080,
      "lb": {
        "target": "api",
        "algorithm": "round-robin",
        "check_path": "/healthz",
        "interval_ms": 1000,
        "timeout_ms": 1000,
        "fall": 2,
        "rise": 2,
        "servers": [
          {
            "name": "api-0",
            "addr": "lore-toxiproxy:20002"
          },
          {
            "name": "api-1",
            "addr": "lore-toxiproxy:20003"
          }
        ],
        "server_port": 8080,
        "stats_listen": 8405
      }
    }
  ],
  "proxies": [
    {
      "name": "api--cache",
      "from": "api",
      "to": "cache",
      "upstream": "cache:6379",
      "listen": 20000
    },
    {
      "name": "api--db",
      "from": "api",
      "to": "db",
      "upstream": "db:5432",
      "listen": 20001
    },
    {
      "name": "lb--api-0",
      "from": "lb",
      "to": "api",
      "upstream": "api-0:8080",
      "listen": 20002
    },
    {
      "name": "lb--api-1",
      "from": "lb",
      "to": "api",
      "upstream": "api-1:8080",
      "listen": 20003
    }
  ],
  "workload": {
    "entry": "lb",
    "urls": [
      "http://lb:8080"
    ],
    "start_rate": 50,
    "stages": [
      {
        "target": 300,
        "duration": "30s"
      },
      {
        "target": 300,
        "duration": "30s"
      }
    ],
    "peak_rate": 300,
    "read_share": 0.9,
    "keys": {
      "distribution": "zipf",
      "count": 20000,
      "skew": 1.1
    },
    "payload_bytes": 1024,
    "max_vus": 600,
    "pre_vus": 75,
    "timeout": "10s"
  },
  "faults": [
    {
      "index": 0,
      "at": "20s",
      "for": "10s",
      "inject": "latency",
      "target": "db",
      "proxies": [
        "api--db"
      ],
      "add_ms": 50
    },
    {
      "index": 1,
      "at": "45s",
      "inject": "kill",
      "target": "api",
      "containers": [
        "api-1"
      ]
    }
  ],
  "infra": {
    "load_cpu": 1,
    "load_memory": 1073741824,
    "proxy_cpu": 0.5,
    "proxy_memory": 1073741824,
    "prometheus_cpu": 0.25,
    "prometheus_memory": 1073741824,
    "cadvisor_cpu": 0.25,
    "cadvisor_memory": 268435456,
    "exporter_cpu": 0.1,
    "exporter_memory": 134217728,
    "expected_proxied_ops": 1140,
    "synthetic_image": "loadlore/synthetic:dev"
  },
  "notes": [
    "Loadlore's own containers get fixed budgets: load generator 1 CPU (peak 300 rps), Toxiproxy 0.5 CPU (about 1140 proxied calls/s at peak), Prometheus 0.25, cAdvisor 0.25, exporters 0.1 each"
  ],
  "assumptions": [
    {
      "field": "services.cache.config.maxmemory",
      "value": "96m",
      "why": "75% of the container's 128m memory limit, as managed Redis usually does; the rest is for fragmentation and client buffers. Set maxmemory: 0 for stock Redis (no cap)"
    },
    {
      "field": "services.cache.config.maxmemory-policy",
      "value": "allkeys-lru",
      "why": "evict the least recently used keys when the cache is full, as managed Redis usually does"
    },
    {
      "field": "workload.timeout_ms",
      "value": "10s",
      "why": "the default; k6 gives up on a request after this long and counts it as failed"
    },
    {
      "field": "resources.cpu_period_ms",
      "value": "100 ms for api, cache, db, lb",
      "why": "Docker's default. A container that uses its CPU share early in a period stalls until the next one, which can show up in p99 when a service has a fraction of a CPU"
    },
    {
      "field": "services.lb timeouts",
      "value": "connect 5s, server 60s",
      "why": "HAProxy's own timeouts, with its defaults otherwise. A request already sent to a replica that dies waits for the server timeout (or the load generator's); health checks only stop new requests going there"
    }
  ]
}
