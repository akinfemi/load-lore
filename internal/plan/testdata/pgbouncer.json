      "name": "pgb",
      "kind": "pgbouncer",
      "image": "edoburu/pgbouncer:v1.26.1-p0",
      "containers": [
        "pgb"
      ],
      "cpu": 0.5,
      "cpu_period_ms": 100,
      "memory": 134217728,
      "port": 6432,
      "config": {
        "max_client_conn": "200"
      },
      "pgbouncer": {
        "target": "db",
        "pool_mode": "transaction",
        "default_pool_size": 20,
        "max_client_conn": 200,
        "upstream": "lore-toxiproxy:20005"
      }
    }
  ],
  "proxies": [
    {
      "name": "api--pgb",
      "from": "api",
      "to": "pgb",
      "upstream": "pgb:6432",
      "listen": 20000
    },
    {
      "name": "lb--api-0",
      "from": "lb",
      "to": "api",
      "upstream": "api-0:8080",
      "listen": 20001
    },
    {
      "name": "lb--api-1",
      "from": "lb",
      "to": "api",
      "upstream": "api-1:8080",
      "listen": 20002
    },
    {
      "name": "lb--api-2",
      "from": "lb",
      "to": "api",
      "upstream": "api-2:8080",
      "listen": 20003
    },
    {
      "name": "lb--api-3",
      "from": "lb",
      "to": "api",
      "upstream": "api-3:8080",
      "listen": 20004
    },
    {
      "name": "pgb--db",
      "from": "pgb",
      "to": "db",
      "upstream": "db:5432",
      "listen": 20005
    }
  ],
  "workload": {
    "entry": "lb",
    "urls": [
      "http://lb:8080"
    ],
    "start_rate": 50,
    "stages": [
      {
        "target": 1000,
        "duration": "1m0s"
      }
    ],
    "peak_rate": 1000,
    "read_share": 0.9,
    "keys": {
      "distribution": "uniform",
      "count": 100000
    },
    "payload_bytes": 1024,
    "max_vus": 2000,
    "pre_vus": 500,
    "timeout": "10s",
    "slo_p99_ms": 500
  },
  "faults": null,
  "infra": {
    "load_cpu": 1,
    "load_memory": 2147483648,
    "proxy_cpu": 0.5,
    "proxy_memory": 1073741824,
    "prometheus_cpu": 0.1,
    "prometheus_memory": 1073741824,
    "cadvisor_cpu": 0.1,
    "cadvisor_memory": 268435456,
    "exporter_cpu": 0.1,
    "exporter_memory": 134217728,
    "expected_proxied_ops": 5200,
    "synthetic_image": "loadlore/synthetic:dev"
  },
  "notes": [
    "Loadlore's own containers get fixed budgets: load generator 1 CPU (peak 1000 rps), Toxiproxy 0.5 CPU (about 5200 proxied calls/s at peak), Prometheus 0.1, cAdvisor 0.1, exporters 0.1 each"
  ],
  "assumptions": [
    {
      "field": "workload.timeout_ms",
      "value": "10s",
      "why": "the default; k6 gives up on a request after this long and counts it as failed"
    },
    {
      "field": "workload.slo.p99_ms",
      "value": "500 ms",
      "why": "the default; a break on p99 alone needs p99 at or above this as well as 10x the low-load p99, so latency users would still accept isn't called a break"
    },
    {
      "field": "resources.cpu_period_ms",
      "value": "100 ms for api, db, lb, pgb",
      "why": "Docker's default. A container that uses its CPU share early in a period stalls until the next one, which can show up in p99 when a service has a fraction of a CPU"
    },
    {
      "field": "services.lb timeouts",
      "value": "connect 5s, server 60s",
      "why": "HAProxy's own timeouts, with its defaults otherwise. A request already sent to a replica that dies waits for the server timeout (or the load generator's); health checks only stop new requests going there"
    },
    {
      "field": "services.pgb.pool_mode",
      "value": "transaction",
      "why": "a server connection serves one client's transaction, then the next client's (transaction); for the whole client connection (session); or for one statement (statement). Loadlore's default is transaction, PgBouncer's is session"
    },
    {
      "field": "services.pgb.default_pool_size",
      "value": "20",
      "why": "server connections to db for the database and user; clients beyond them wait in PgBouncer for one"
    },
    {
      "field": "services.pgb.config.max_client_conn",
      "value": "200",
      "why": "set in the design: clients beyond it are refused"
    },
    {
      "field": "services.pgb.config.server_login_retry",
      "value": "15s",
      "why": "PgBouncer's own default: after a failed connection to db, PgBouncer waits this long before trying again, so it can recover from a restart of db later than a direct client would"
    },
    {
      "field": "services.api.pools.pgb.min",
      "value": "0",
      "why": "the default, as pgxpool's: each replica opens connections only when callers need them, so a pool fills as load rises, and a burst opens many at once"
    },
    {
      "field": "services.api.pools.pgb.hold",
      "value": "call",
      "why": "the default, as pgxpool's: a request takes a connection for each call and hands it back straight away"
    }
  ]
}
