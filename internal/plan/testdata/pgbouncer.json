      ],
      "cpu": 0.5,
      "cpu_period_ms": 100,
      "memory": 268435456,
      "port": 8080,
      "lb": {
        "target": "api",
        "algorithm": "round-robin",
        "check_path": "/healthz",
        "interval_ms": 2000,
        "timeout_ms": 1000,
        "fall": 3,
        "rise": 2,
        "servers": [
