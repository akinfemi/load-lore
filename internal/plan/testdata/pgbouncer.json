            "name": "api-0",
            "addr": "lore-toxiproxy:20001"
          },
          {
            "name": "api-1",
            "addr": "lore-toxiproxy:20002"
          },
          {
            "name": "api-2",
            "addr": "lore-toxiproxy:20003"
          },
          {
            "name": "api-3",
            "addr": "lore-toxiproxy:20004"
          }
        ],
