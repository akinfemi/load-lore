  "network": {
    "profile": "same-zone",
    "rtt_ms": 0.3
  },
  "notes": [
    "scale 0.5: CPU, memory, memory settings, dataset rows, the keyspace and request rates are multiplied by 0.5; replicas, pool sizes, connection limits and per-request work are not",
    "db: shared_buffers scaled from 256MB to 131072kB",
    "lb: memory kept at 169m instead of 128m: about 40k for each of up to 3500 client connections, which don't scale",
    "Loadlore's own containers get fixed budgets: load generator 1.5 CPU (peak 1750 rps), Prometheus 0.1, cAdvisor 0.1, exporters 0.1 each. No fault acts on a connection, so every connection is direct and there is no Toxiproxy"
  ],
  "assumptions": [
    {
      "field": "workload.timeout_ms",
      "value": "10s",
      "why": "the default; k6 gives up on a request after this long and counts it as failed"
    },
    {
      "field": "workload.slo.p99_ms",
      "value": "500 ms",
      "why": "the default; a break on p99 alone needs p99 at or above this as well as 10x the low-load p99, so latency users would still accept isn't called a break"
    },
    {
      "field": "network.profile",
      "value": "same-zone: 0.3 ms round trip",
      "why": "the default: every service in one availability zone. AWS says a round trip between two instances in the same zone is generally sub-millisecond with enhanced networking, and publishes no exact figure, so the 0.3 ms round trip Loadlore adds between any two containers is its own estimate, inside that bound. Applied between any two of the stack's containers, the load generator and the entry point included, as half the round trip on each side's outgoing packets; Loadlore's own tooling isn't slowed. Not scaled with --scale. Source: AWS Architecture Blog, Improving performance and reducing cost using Availability Zone Affinity: https://aws.amazon.com/blogs/architecture/improving-performance-and-reducing-cost-using-availability-zone-affinity/"
    },
    {
      "field": "resources.cpu_period_ms",
      "value": "100 ms for api, db, lb",
      "why": "Docker's default. A container that uses its CPU share early in a period stalls until the next one, which can show up in p99 when a service has a fraction of a CPU"
    },
    {
      "field": "services.db.disk",
      "value": "gp3: 1 ms per read, 1 ms per write, 1500 IOPS, 62.5 MiB/s",
      "why": "a gp3 volume at its baseline: 3,000 IOPS and 125 MiB/s, included in its price, and up to 80,000 IOPS provisioned. AWS publishes no exact latency, only single-digit milliseconds. Loadlore asks dm-delay for 1 ms on every read, write and flush, but dm-delay counts in the kernel's 1 ms ticks, so a request waits 0 to 1 ms, about 0.45 ms on average (measured 19 Nov): below AWS's range, so the disk is flattered rather than handicapped. A WAL flush is a write and a flush, each waiting, so a commit waits about 1.2 ms longer (measured the same day). Each run measures the waits it stood on, given below. Reads and writes are capped separately, so a mixed load can reach up to twice the IOPS. Provisioned throughput isn't modelled. Source: AWS, Amazon EBS General Purpose SSD volumes: https://docs.aws.amazon.com/ebs/latest/userguide/general-purpose.html; IOPS and throughput scaled with --scale, the waits not"
    },
    {
      "field": "services.lb timeouts",
      "value": "connect 5s, server 60s",
      "why": "HAProxy's own timeouts, with its defaults otherwise. A request already sent to a replica that dies waits for the server timeout (or the load generator's); health checks only stop new requests going there"
    },
    {
      "field": "services.api.pools.db.min",
      "value": "24",
      "why": "set in the design: each replica opens 24 connections before the load starts and keeps them open"
    },
    {
      "field": "services.api.pools.db.hold",
      "value": "call",
      "why": "the default, as pgxpool's: a request takes a connection for each call and hands it back straight away"
    }
  ]
