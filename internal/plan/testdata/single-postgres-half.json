      "listen": 20004
    }
  ],
  "workload": {
    "entry": "lb",
    "urls": [
      "http://lb:8080"
    ],
    "start_rate": 50,
    "stages": [
      {
        "target": 2500,
        "duration": "5m0s"
      },
      {
        "target": 2500,
        "duration": "2m0s"
      }
    ],
    "peak_rate": 2500,
    "read_share": 0.9,
    "keys": {
      "distribution": "zipf",
      "count": 2500000,
      "skew": 1.1
    },
    "payload_bytes": 1024,
    "max_vus": 4000,
    "pre_vus": 625,
    "timeout": "10s"
  },
  "faults": null,
  "infra": {
    "load_cpu": 1,
    "load_memory": 2147483648,
    "proxy_cpu": 1,
    "proxy_memory": 1073741824,
    "prometheus_cpu": 0.25,
    "prometheus_memory": 1073741824,
    "cadvisor_cpu": 0.25,
    "cadvisor_memory": 268435456,
    "exporter_cpu": 0.1,
    "exporter_memory": 134217728,
    "expected_proxied_ops": 10250,
    "synthetic_image": "loadlore/synthetic:dev"
  },
  "notes": [
    "scale 0.5: CPU, memory, memory settings, dataset rows, the keyspace and request rates are multiplied by 0.5; replicas, pool sizes, connection limits and per-request work are not",
    "db: shared_buffers scaled from 256MB to 131072kB",
    "lb: memory kept at 189m instead of 128m: about 40k for each of up to 4000 client connections, which don't scale",
    "Loadlore's own containers get fixed budgets: load generator 1 CPU (peak 2500 rps), Toxiproxy 1 CPU (about 10250 proxied calls/s at peak), Prometheus 0.25, cAdvisor 0.25, exporters 0.1 each"
  ],
  "assumptions": [
    {
      "field": "workload.timeout_ms",
      "value": "10s",
      "why": "the default; k6 gives up on a request after this long and counts it as failed"
    },
    {
      "field": "services.lb timeouts",
      "value": "connect 5s, server 60s",
      "why": "HAProxy's own timeouts, with its defaults otherwise. A request already sent to a replica that dies waits for the server timeout (or the load generator's); health checks only stop new requests going there"
    }
  ]
}
