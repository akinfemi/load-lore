      "name": "api--db",
      "from": "api",
      "to": "db",
      "upstream": "db:5432",
      "listen": 20000
    },
    {
      "name": "lb--api-0",
      "from": "lb",
      "to": "api",
      "upstream": "api-0:8080",
      "listen": 20001
    },
    {
      "name": "lb--api-1",
      "from": "lb",
      "to": "api",
      "upstream": "api-1:8080",
      "listen": 20002
    },
    {
      "name": "lb--api-2",
      "from": "lb",
      "to": "api",
      "upstream": "api-2:8080",
      "listen": 20003
    },
    {
      "name": "lb--api-3",
      "from": "lb",
      "to": "api",
      "upstream": "api-3:8080",
      "listen": 20004
    }
  ],
  "workload": {
    "entry": "lb",
    "urls": [
      "http://lb:8080"
    ],
    "start_rate": 100,
    "stages": [
      {
        "target": 5000,
        "duration": "5m0s"
      },
      {
        "target": 5000,
        "duration": "2m0s"
      }
    ],
    "peak_rate": 5000,
    "read_share": 0.9,
    "keys": {
      "distribution": "zipf",
      "count": 5000000,
      "skew": 1.1
    },
    "payload_bytes": 1024,
    "max_vus": 4000,
    "pre_vus": 2500,
    "timeout": "10s",
    "slo_p99_ms": 500
  },
  "faults": null,
  "infra": {
    "load_cpu": 2,
    "load_memory": 2147483648,
    "proxy_cpu": 1.5,
    "proxy_memory": 1073741824,
    "prometheus_cpu": 0.1,
    "prometheus_memory": 1073741824,
    "cadvisor_cpu": 0.1,
    "cadvisor_memory": 268435456,
    "exporter_cpu": 0.1,
    "exporter_memory": 134217728,
    "expected_proxied_ops": 20500,
    "synthetic_image": "loadlore/synthetic:dev"
  },
  "notes": [
    "Loadlore's own containers get fixed budgets: load generator 2 CPU (peak 5000 rps), Toxiproxy 1.5 CPU (about 20500 proxied calls/s at peak), Prometheus 0.1, cAdvisor 0.1, exporters 0.1 each"
  ],
  "assumptions": [
    {
      "field": "workload.timeout_ms",
      "value": "10s",
      "why": "the default; k6 gives up on a request after this long and counts it as failed"
    },
    {
      "field": "workload.slo.p99_ms",
      "value": "500 ms",
      "why": "the default; a break on p99 alone needs p99 at or above this as well as 10x the low-load p99, so latency users would still accept isn't called a break"
    },
    {
      "field": "resources.cpu_period_ms",
      "value": "100 ms for api, db, lb",
      "why": "Docker's default. A container that uses its CPU share early in a period stalls until the next one, which can show up in p99 when a service has a fraction of a CPU"
    },
    {
      "field": "services.lb timeouts",
      "value": "connect 5s, server 60s",
      "why": "HAProxy's own timeouts, with its defaults otherwise. A request already sent to a replica that dies waits for the server timeout (or the load generator's); health checks only stop new requests going there"
    }
  ]
}
